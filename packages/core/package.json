{
  "name": "@babeli/core",
  "version": "1.0.0",
  "description": "Core library of babeli: translation file readers/writers and AI-powered actions",
  "keywords": [
    "ai",
    "babeli",
    "i18n",
    "llm",
    "localization",
    "translation"
  ],
  "homepage": "https://github.com/uebelack/babeli/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/uebelack/babeli/issues"
  },
  "license": "MIT",
  "author": "David Übelacker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uebelack/babeli.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@langchain/core": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
