{
  "name": "@babeli/cli",
  "version": "1.0.0",
  "description": "Command-line interface for babeli, AI-powered translation management",
  "keywords": [
    "ai",
    "babeli",
    "i18n",
    "llm",
    "localization",
    "translation"
  ],
  "homepage": "https://github.com/uebelack/babeli/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/uebelack/babeli/issues"
  },
  "license": "MIT",
  "author": "David Übelacker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uebelack/babeli.git",
    "directory": "packages/cli"
  },
  "bin": {
    "babeli": "./dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/main.ts --dts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@babeli/core": "workspace:^",
    "@clack/prompts": "^1.9.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
