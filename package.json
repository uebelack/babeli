{
  "name": "babeli",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "format:check": "oxfmt --check .",
    "integration": "pnpm --filter @babeli/example integration",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "format:write": "oxfmt .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
